# One host serves everything now: the website and the MCP endpoint. So the site's
# own files travel too — scripts/stage-site.mjs assembles them into public/,
# which is what actually gets served.
#
# Every pattern is anchored with a leading slash. Without one, gitignore syntax
# matches at any depth: a bare `tools/` also excludes `mcp/src/tools/`, which
# deploys a server whose own tool modules are missing and fails in `tsc` rather
# than anywhere useful. CI checks out from git and never reads this file, so it
# cannot catch that for you — `npm --prefix mcp run check:deploy` can.
/.github/
/.cache/
/tools/
/mcp/node_modules/
/mcp/dist/
/mcp/*.tgz
/public/
